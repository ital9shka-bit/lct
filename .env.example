# W1: application and PostgreSQL
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://stroykontrol:stroykontrol-local@postgres:5432/stroykontrol
POSTGRES_PASSWORD=stroykontrol-local
FRONTEND_ORIGINS=http://127.0.0.1:8180,http://localhost:8180

# Browser session and demonstration access
SESSION_COOKIE_NAME=stroykontrol_session
SESSION_TTL_HOURS=168
SESSION_COOKIE_SECURE=false
DEMO_LOGIN=demo
DEMO_PASSWORD=demo
DEMO_EMAIL=demo@demo.stroykontrol.ru
# Период показа: этапы демо-плана идут в эти даты. Для репетиции раньше 29.09
# сдвиньте DEMO_PERIOD_START на дату репетиции и выполните reset-demo --yes.
DEMO_PERIOD_START=2026-09-29
DEMO_PERIOD_END=2026-10-15
REGISTRATION_LIMIT_COUNT=5
REGISTRATION_LIMIT_WINDOW_SECONDS=900

# Private S3/MinIO storage. Change all development credentials outside localhost.
MINIO_ROOT_USER=stroykontrol-root
MINIO_ROOT_PASSWORD=stroykontrol-root-local
S3_ENABLED=true
S3_ENDPOINT=http://minio:9000
S3_PRESIGN_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=stroykontrol-dev
S3_PREFIX=stroykontrol
S3_ACCESS_KEY=stroykontrol-app
S3_SECRET_KEY=stroykontrol-app-local
S3_PRESIGNED_TTL_SECONDS=900

# RuSender. Registration remains successful when mail is disabled or unavailable.
MAIL_ENABLED=false
RUSENDER_BASE_URL=https://api.rusender.ru
RUSENDER_API_KEY=
RUSENDER_KEY_ID=
MAIL_FROM=
MAIL_FROM_NAME=СтройКонтроль
MAIL_LOGIN_URL=http://127.0.0.1:8180/#/login
MAIL_TECHNICAL_DOMAIN_NOTE=

# W0/W3: AI analysis contract
AI_PROVIDER=gatellm
AI_BASE_URL=https://gatellm.ru/v1
AI_API_KEY=
AI_MODEL=openai/gpt-6-luna
AI_API_STYLE=chat_completions
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=90
AI_IMAGE_MAX_EDGE=1024
AI_IMAGE_JPEG_QUALITY=75

# Повторы и резервная модель. Битый ответ или сбой провайдера → повтор той же модели,
# затем столько же попыток у резервной. Пустые AI_FALLBACK_* наследуют основные значения
# (тот же GateLLM и ключ). Пустой AI_FALLBACK_MODEL отключает резерв.
AI_ATTEMPTS_PER_MODEL=2
AI_FALLBACK_MODEL=x-ai/grok-4.7
AI_FALLBACK_PROVIDER=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_API_STYLE=
AI_FALLBACK_REASONING_EFFORT=

# Cost estimate only. Replace with the actual GateLLM tariff if it differs.
AI_INPUT_PRICE_PER_MILLION=0.20
AI_OUTPUT_PRICE_PER_MILLION=1.20
