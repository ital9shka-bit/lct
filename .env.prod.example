# Скопируйте в .env.prod на сервере и заполните. Файл .env.prod в репозиторий не попадает.
DOMAIN=
ACME_EMAIL=
POSTGRES_PASSWORD=

# Демо-доступ жюри
DEMO_LOGIN=demo
DEMO_PASSWORD=demo
DEMO_EMAIL=demo@demo.stroykontrol.ru
# Этапы демо-плана идут в эти даты. seed-demo работает только внутри периода:
# для репетиции до 29.09 временно поставьте DEMO_PERIOD_START на дату репетиции,
# а 29.09 верните 2026-09-29 и выполните reset-demo --yes.
DEMO_PERIOD_START=2026-09-29
DEMO_PERIOD_END=2026-10-15

# Общий S3 (бакет с другими проектами; приложение пишет только в префикс)
S3_ENDPOINT=
S3_PRESIGN_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=
S3_PREFIX=stroykontrol
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Почта RuSender
MAIL_ENABLED=true
MAIL_PROVIDER=rusender
RUSENDER_API_KEY=
RUSENDER_KEY_ID=
MAIL_FROM=
MAIL_FROM_NAME=СтройКонтроль

# Модель: GateLLM, резерв x-ai/grok-4.7 через тот же шлюз
AI_PROVIDER=gatellm
AI_BASE_URL=https://gatellm.ru/v1
AI_API_KEY=
AI_MODEL=openai/gpt-6-luna
AI_API_STYLE=chat_completions
AI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=90
AI_ATTEMPTS_PER_MODEL=2
AI_FALLBACK_MODEL=x-ai/grok-4.7
